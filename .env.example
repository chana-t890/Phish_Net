# Database
DATABASE_URL=postgresql://phishnet:phishnet@localhost:5432/phishnet

# Okta SAML
SAML_ISSUER=http://localhost:3000
SAML_ENTRY_POINT=
SAML_IDP_CERT=
BASE_URL=http://localhost:3000

# Session cookie signing secret — generate with: openssl rand -base64 33
NUXT_SESSION_PASSWORD=

# Dev only: skips Okta SAML when host is localhost and NODE_ENV != production
AUTH_DEV_EMAIL=

# AWS / Amazon Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Admin access — comma-separated email list; grants role=admin on login
ADMIN_EMAILS=admin@example.com

# Kaggle dataset ingestion
KAGGLE_USERNAME=
KAGGLE_KEY=
